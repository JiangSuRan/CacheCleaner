<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 版本号与 MainForm 标题 / setup.iss 保持同步，否则 exe 文件属性停留在默认 1.0.0 -->
    <Version>4.1.0</Version>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 嵌入管理员提权清单：清理系统目录 + MoveFileEx 重启删除均需要管理员权限 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- .NET 10 WinForms 推荐：DPI 模式由项目属性而非 manifest 声明（消除 WFO0003） -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="theme_bg.png" />
    <EmbeddedResource Include="rules.default.json" />
    <EmbeddedResource Include="agents.catalog.json" />
  </ItemGroup>

</Project>